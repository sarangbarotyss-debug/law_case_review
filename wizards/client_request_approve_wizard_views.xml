<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_client_request_approve_wizard_form" model="ir.ui.view">
        <field name="name">client.request.approve.wizard.form</field>
        <field name="model">client.request.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve Client Request">
                <field name="client_request_ids" invisible="1"/>
                <group>
                    <field name="playbook_source_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_confirm_approve" type="object"
                            string="Approve" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>