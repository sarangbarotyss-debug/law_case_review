<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_client_request_upload_wizard_form" model="ir.ui.view">
            <field name="name">view.client.request.upload.wizard.form</field>
            <field name="model">client.request.upload.wizard</field>
            <field name="arch" type="xml">
                <form string="Upload Client Request Document">

                    <!-- Upload screen -->
                    <group invisible="stage != 'upload'">
                        <field name="file" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                        <div class="alert alert-danger" role="alert" invisible="not error_message">
                            <field name="error_message" readonly="1" nolabel="1"/>
                        </div>
                    </group>

                    <!-- Progress screen -->
                    <group invisible="stage != 'progress'">
                        <field name="client_request_id" widget="law_client_request_progress" nolabel="1" colspan="2"/>
                    </group>

                    <footer invisible="stage != 'upload'">
                        <button name="action_extract_and_create" type="object" class="btn-primary" string="Extract &amp; Create"/>
                        <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"/>
                    </footer>

                </form>
            </field>
        </record>
        <record id="action_client_request_upload_wizard" model="ir.actions.act_window">
            <field name="name">action.client.request.upload.wizard</field>
            <field name="res_model">client.request.upload.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>