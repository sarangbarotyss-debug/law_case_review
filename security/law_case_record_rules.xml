        </record>
        <record id="rule_law_client_request_lawyer" model="ir.rule">
            <field name="name">Client Request: Lawyer sees own only</field>
            <field name="model_id" ref="model_law_client_request"/>
            <field name="domain_force">[('lawyer_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_lawyer'))]"/>
        </record>

        <record id="rule_law_client_request_manager" model="ir.rule">
            <field name="name">Client Request: Manager sees all</field>
            <field name="model_id" ref="model_law_client_request"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_manager'))]"/>
        </record>

        <record id="rule_law_case_timeline_event_lawyer" model="ir.rule">
            <field name="name">Timeline Event: Lawyer sees own case events only</field>
            <field name="model_id" ref="model_law_case_timeline_event"/>
            <field name="domain_force">[('case_id.lawyer_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_lawyer'))]"/>
        </record>

        <record id="rule_law_case_timeline_event_manager" model="ir.rule">
            <field name="name">Timeline Event: Manager sees all</field>
            <field name="model_id" ref="model_law_case_timeline_event"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_manager'))]"/>
        </record>

        <!-- Document Chunks -->
        <record id="rule_law_case_document_chunk_lawyer" model="ir.rule">
            <field name="name">Document Chunk: Lawyer sees own case's chunks</field>
            <field name="model_id" ref="model_law_case_document_chunk"/>
            <field name="domain_force">[('case_id.lawyer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_lawyer'))]"/>
        </record>
        <record id="rule_law_case_document_chunk_manager" model="ir.rule">
            <field name="name">Document Chunk: Manager sees all chunks</field>
            <field name="model_id" ref="model_law_case_document_chunk"/>
            <field name="domain_force">[(1, '=', 1)]</field>
