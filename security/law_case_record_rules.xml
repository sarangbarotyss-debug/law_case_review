        </record>
        <record id="rule_law_case_party_manager" model="ir.rule">
            <field name="name">Party: Manager sees all parties</field>
            <field name="model_id" ref="model_law_case_party"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_manager'))]"/>
        </record>

        <!-- Q&A Log -->
        <record id="rule_law_case_qa_log_lawyer" model="ir.rule">
            <field name="name">Q&amp;A Log: Lawyer sees own case's Q&amp;A</field>
            <field name="model_id" ref="model_law_case_qa_log"/>
            <field name="domain_force">[('case_id.lawyer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_lawyer'))]"/>
        </record>
        <record id="rule_law_case_qa_log_manager" model="ir.rule">
            <field name="name">Q&amp;A Log: Manager sees all Q&amp;A</field>
            <field name="model_id" ref="model_law_case_qa_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_manager'))]"/>
        </record>

        <!-- Playbook Matches -->
        <record id="rule_law_case_playbook_match_lawyer" model="ir.rule">
            <field name="name">Playbook Match: Lawyer sees own case's matches</field>
            <field name="model_id" ref="model_law_case_playbook_match"/>
            <field name="domain_force">[('case_id.lawyer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_lawyer'))]"/>
        </record>
        <record id="rule_law_case_playbook_match_manager" model="ir.rule">
            <field name="name">Playbook Match: Manager sees all matches</field>
            <field name="model_id" ref="model_law_case_playbook_match"/>
            <field name="domain_force">[(1, '=', 1)]</field>
