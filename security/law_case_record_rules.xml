        <record id="rule_client_request_approve_wizard_lawyer" model="ir.rule">
            <field name="name">Client Request Approve Wizard: lawyer sees own requests</field>
            <field name="model_id" ref="model_client_request_approve_wizard"/>
            <field name="domain_force">[('client_request_ids.lawyer_id', '=', user.id)]</field>
