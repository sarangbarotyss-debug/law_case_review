        <record id="rule_law_case_party_lawyer" model="ir.rule">
            <field name="name">Party: Lawyer sees own case's parties</field>
            <field name="model_id" ref="model_law_case_party"/>
            <field name="domain_force">[('case_id.lawyer_id', '=', user.id)]</field>
