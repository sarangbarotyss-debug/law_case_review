<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cases -->
        <record id="rule_law_case_lawyer" model="ir.rule">
            <field name="name">Law Case: Lawyer sees own cases only</field>
            <field name="model_id" ref="model_law_case"/>
            <field name="domain_force">[('lawyer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_lawyer'))]"/>
        </record>
        <record id="rule_law_case_manager" model="ir.rule">
            <field name="name">Law Case: Manager sees all cases</field>
            <field name="model_id" ref="model_law_case"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_manager'))]"/>
        </record>

        <!-- Documents -->
        <record id="rule_law_case_document_lawyer" model="ir.rule">
            <field name="name">Law Case Document: Lawyer sees own case's documents</field>
            <field name="model_id" ref="model_law_case_document"/>
            <field name="domain_force">[('case_id.lawyer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_lawyer'))]"/>
        </record>
        <record id="rule_law_case_document_manager" model="ir.rule">
            <field name="name">Law Case Document: Manager sees all documents</field>
            <field name="model_id" ref="model_law_case_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_law_case_manager'))]"/>
        </record>

