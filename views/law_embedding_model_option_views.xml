<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_law_embedding_model_option_list" model="ir.ui.view">
        <field name="name">law.embedding.model.option.list</field>
        <field name="model">law.embedding.model.option</field>
        <field name="arch" type="xml">
            <list string="Embedding Models" editable="bottom">
                <field name="name"/>
                <field name="provider"/>
                <field name="model_string"/>
                <field name="dimension"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_law_embedding_model_option" model="ir.actions.act_window">
        <field name="name">Embedding Models</field>
        <field name="res_model">law.embedding.model.option</field>
        <field name="view_mode">list</field>
    </record>
</odoo>