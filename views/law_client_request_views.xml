<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="view_law_client_request_form" model="ir.ui.view">
            <field name="name">law.client.request.form</field>
            <field name="model">law.client.request</field>
            <field name="arch" type="xml">
                <form string="Client Request">
                    <header>
                        <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible = "state != 'request'"/>
                        <button name="action_reject" string="Reject" type="object" invisible = "state != 'request'"/>
                        <field name="state" widget="statusbar" statusbar_visible="request,rejected,approved"/>
                    </header>
                    <sheet>
                        <group string="Personal Details">
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                        </group>
                        <group string="Address Details">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                            <field name="lawyer_id" readonly="not is_case_manager"/>
                            <field name="is_case_manager" invisible="1"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Matter Deetials">
                            <field name="matter_type"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                    <field name="file" invisible="1"/>
                    <field name="file_name" invisible="1"/>
                </form>
            </field>
        </record>
        <record id="view_law_client_request_list" model="ir.ui.view">
            <field name="name">law.client.request.list</field>
            <field name="model">law.client.request</field>
            <field name="arch" type="xml">
                <list string="Client Request">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="lawyer_id"/>
                    <field name="matter_type"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="action_law_client_request" model="ir.actions.act_window">
            <field name="name">Client Request</field>
            <field name="res_model">law.client.request</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>